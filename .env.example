# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.uz
CSRF_TRUSTED_ORIGINS=https://your-domain.uz
LOG_LEVEL=INFO

# --- Autentifikatsiya (email + parol) --------------------------------------
JWT_SECRET=change-me-too
JWT_TTL_SECONDS=3600
# Kirish/ro'yxatdan o'tish urinishlari IP bo'yicha shu chegara bilan cheklanadi.
THROTTLE_AUTH=10/min

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=speaking
POSTGRES_USER=speaking
POSTGRES_PASSWORD=speaking
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Gemini Live (ovoz) ---------------------------------------------------
# Kalit FAQAT server tomonda qoladi, clientga hech qachon berilmaydi.
GEMINI_API_KEY=
# Mavjud live modellarni ko'rish:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" \
#     | grep -B4 bidiGenerateContent
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
GEMINI_INPUT_SAMPLE_RATE=16000
GEMINI_OUTPUT_SAMPLE_RATE=24000

# --- Narx jadvallari (1M token uchun USD) --------------------------------
# Har sessiyaning aniq narxi hisoblanadi va SessionMetrics.cost_usd ga yoziladi.
# Standart qiymatlar `config/settings.py` da; Google narxni o'zgartirsa shu yerda
# JSON bilan qayta yozing (kodga tegmasdan):
#   LIVE_PRICING_JSON={"gemini-3.1-flash-live":{"text_in":0.75,"audio_in":3.0,"text_out":4.5,"audio_out":12.0}}
LIVE_PRICING_JSON=
#   TEXT_LLM_PRICING_JSON={"gpt-oss-20b":{"text_in":0.05,"text_out":0.20}}
TEXT_LLM_PRICING_JSON=

# --- Sessiyadan keyingi tahlil LLM'i (OpenAI-mos istalgan endpoint) -------
# Fireworks.ai — OpenAI-mos endpoint. Boshqa provayder ham bo'ladi.
ANALYSIS_API_BASE=https://api.fireworks.ai/inference/v1
ANALYSIS_API_KEY=
ANALYSIS_MODEL=accounts/fireworks/models/gpt-oss-120b
ANALYSIS_TIMEOUT_SECONDS=60
# gpt-oss reasoning modeli: low|medium|high. Bo'sh qoldirilsa yuborilmaydi.
ANALYSIS_REASONING_EFFORT=low

# --- Real vaqtdagi coach LLM'i (tizimning "miyasi") ----------------------
# Har o'quvchi javobidan keyin ishlaydi: verdict, grammatik xatolar, podkaska,
# dinamik savol va ohang. TEZ va KICHIK model kerak — 120b reasoning emas.
# Bo'sh qoldirilsa ANALYSIS_* qiymatlari meros olinadi.
COACH_API_BASE=
COACH_API_KEY=
COACH_MODEL=accounts/fireworks/models/gpt-oss-20b
# Coach kritik yo'lda emas: kechiksa suhbat deterministik mantiq bilan davom etadi.
COACH_TIMEOUT_SECONDS=6
COACH_REASONING_EFFORT=low
COACH_MAX_TOKENS=700
# Bitta sessiyaga tushadigan coach chaqiruvlari tomi (narx nazorati).
COACH_MAX_CALLS=40

# --- Kontent generatsiya LLM'i (bo'sh bo'lsa ANALYSIS_* ishlatiladi) ------
CONTENT_API_BASE=
CONTENT_API_KEY=
CONTENT_MODEL=

# --- Kvota / sessiya limitlari -------------------------------------------
QUOTA_TIMEZONE=Asia/Tashkent
# `none` → kunlik limit yo'q (sinov paytida qulay).
FREE_DAILY_SESSIONS=1
FREE_DURATION_SECONDS=300
PREMIUM_DURATION_SECONDS=900
SESSION_RESUME_GRACE_SECONDS=60
# Bitta foydalanuvchiga kuniga ketadigan haqiqiy pul tomi (USD). Sessiya soni
# cheksiz tarifda ham sarf nazoratsiz o'smasligi uchun. 0 → tom yo'q.
DAILY_COST_CAP_USD=0

# --- Routing thresholdlari (§4.7) ----------------------------------------
MASTERY_ACCURACY=0.80
STRUGGLING_ACCURACY=0.50

# --- Deploy ---------------------------------------------------------------
# Windows'da 8081-8880 oralig'ini WinNAT o'ziga band qilib qo'yishi mumkin —
# o'sha portga Docker bog'lana olmaydi. Tekshirish:
#   netsh interface ipv4 show excludedportrange protocol=tcp
HTTP_PORT=9100
# Mini App qaysi manzilga so'rov yuboradi (bo'sh = shu origin)
VITE_API_BASE=
VITE_WS_BASE=
# Backend WS URL'ini absolyut qaytarishi uchun (masalan wss://your-domain.uz)
PUBLIC_WS_BASE=
# Birinchi ishga tushirishda seed kontentni yuklash
SEED_CONTENT=1
