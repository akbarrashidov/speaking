# ============================================================================
#  SERVERDAGI .env UCHUN NAMUNA  (167.86.122.56 — Cloud VPS 4)
# ----------------------------------------------------------------------------
#  Serverda:  cp .env.production.example .env  &&  nano .env
#  Bu fayl git'da turadi (sirlar YO'Q). Haqiqiy .env hech qachon commit
#  qilinmaydi — .gitignore uni to'sib turadi.
#
#  Sir generatsiya qilish:
#     openssl rand -hex 48
# ============================================================================

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=BU_YERGA_openssl_rand_hex_48_NATIJASI
DJANGO_DEBUG=0
LOG_LEVEL=INFO

# Domen olinganda shu ikki qatorga domenni qo'shing (IP ham qolsin).
DJANGO_ALLOWED_HOSTS=167.86.122.56,localhost,127.0.0.1
# HTTPS yoqilgunicha http:// turadi; enable-https.sh dan keyin https:// qiling.
CSRF_TRUSTED_ORIGINS=http://167.86.122.56

# nginx ortida turibmiz — X-Forwarded-Proto ga ishonamiz.
USE_PROXY_SSL_HEADER=1
# HTTPS o'rnatilgandan KEYIN 1 qiling. HTTP'da 1 qilsangiz admin'ga kira
# olmaysiz (brauzer secure cookie'ni http orqali yubormaydi).
SECURE_COOKIES=0

# --- Autentifikatsiya -----------------------------------------------------
JWT_SECRET=BU_YERGA_BOSHQA_openssl_rand_hex_48_NATIJASI
JWT_TTL_SECONDS=3600
THROTTLE_AUTH=10/min

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=speaking
POSTGRES_USER=speaking
POSTGRES_PASSWORD=BU_YERGA_KUCHLI_BAZA_PAROLI
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Gemini Live (ovoz) ---------------------------------------------------
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
GEMINI_INPUT_SAMPLE_RATE=16000
GEMINI_OUTPUT_SAMPLE_RATE=24000

# --- Tahlil LLM'i ---------------------------------------------------------
ANALYSIS_API_BASE=https://api.fireworks.ai/inference/v1
ANALYSIS_API_KEY=
ANALYSIS_MODEL=accounts/fireworks/models/gpt-oss-120b
ANALYSIS_TIMEOUT_SECONDS=60
ANALYSIS_REASONING_EFFORT=low

# --- Coach LLM'i ----------------------------------------------------------
COACH_API_BASE=
COACH_API_KEY=
COACH_MODEL=accounts/fireworks/models/gpt-oss-20b
COACH_TIMEOUT_SECONDS=6
COACH_REASONING_EFFORT=low
COACH_MAX_TOKENS=700
COACH_MAX_CALLS=40

# --- Kontent generatsiya LLM'i -------------------------------------------
CONTENT_API_BASE=
CONTENT_API_KEY=
CONTENT_MODEL=

# --- Kvota / limitlar -----------------------------------------------------
QUOTA_TIMEZONE=Asia/Tashkent
FREE_DAILY_SESSIONS=1
FREE_DURATION_SECONDS=300
PREMIUM_DURATION_SECONDS=900
SESSION_RESUME_GRACE_SECONDS=60
# Prodda 0 (tomsiz) qoldirmang — bitta akkaunt hisobingizni bo'shatib qo'yishi
# mumkin. 1-2 USD real chegara.
DAILY_COST_CAP_USD=2

# --- Routing thresholdlari ------------------------------------------------
MASTERY_ACCURACY=0.80
STRUGGLING_ACCURACY=0.50

# --- Deploy ---------------------------------------------------------------
# Mini App shu origin'ga so'rov yuboradi — bo'sh = joriy manzil. Domen
# qo'shilsa ham bo'sh qoldiring, shunda IP va domen ikkalasi ham ishlaydi.
VITE_API_BASE=
VITE_WS_BASE=
PUBLIC_WS_BASE=

# Birinchi ishga tushirishda kontent yuklansin; keyin 0 qilib qo'ying —
# har deploy'da seed qayta yugurmasin.
SEED_CONTENT=1

# --- Docker Compose -------------------------------------------------------
# nginx qaysi konfig bilan ishga tushadi. enable-https.sh buni prod-ssl.conf
# ga o'zgartiradi — qo'lda tegmang.
NGINX_CONF=prod-http.conf
# HTTPS yoqilganda `tls` bo'ladi (certbot yangilash sikli shunda ishga tushadi).
COMPOSE_PROFILES=
