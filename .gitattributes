# Windows'da klon qilinganda shell skriptlar CRLF bo'lib qolmasin —
# Linux konteynerda `env: 'bash\r': No such file or directory` bilan yiqiladi.
* text=auto eol=lf

*.sh          text eol=lf
entrypoint.sh text eol=lf
Dockerfile    text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf

*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
